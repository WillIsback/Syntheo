{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syntheo Dev",
  "mainBinaryName": "syntheo-dev",
  "identifier": "fr.willisback.syntheo.dev",
  "build": {
    "features": [
      "direct-distribution"
    ],
    "beforeDevCommand": "pnpm -F desktop dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm -F desktop build",
    "beforeBundleCommand": "node ./src-tauri/scripts/before-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' http://localhost:1422",
        "style-src": "'self' 'unsafe-inline' http://localhost:1422",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:1422",
        "media-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self' data: http://localhost:1422",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: http://localhost:1422 ws://localhost:1422",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "publisher": "Syntheo",
    "category": "Productivity",
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libgtk-layer-shell0",
          "libpipewire-0.3-0",
          "libpulse0",
          "libasound2",
          "libssl3",
          "libstdc++6",
          "ca-certificates",
          "desktop-file-utils",
          "xdg-utils",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "externalBin": [],
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "resources": {
      "resources/notification-icons": "notification-icons"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "assets/dmg-background-stable.png",
        "windowSize": {
          "width": 660,
          "height": 430
        },
        "appPosition": {
          "x": 177,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 483,
          "y": 200
        }
      },
      "files": {
        "Resources/AppIcon.icns": "icons/dev/icon.icns"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "syntheo-dev"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4MkQ0NjE4MkVBOTFEMjgKUldRb0hha3VHRVl0YUF3MmVBV2ZTNlU5Wit4R1hETDlBWmRSSk0wNTZwLzNOVi9YNUtMYVNyUHUK",
      "endpoints": [
        "https://github.com/WillIsback/Syntheo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
