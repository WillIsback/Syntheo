# Copier en .env à côté de compose.yaml pour changer les réglages par défaut.

# Clé d'API facultative. Vide : pas de clé (le service n'écoute que sur cette
# machine). À renseigner dans Syntheo si elle est définie.
ASR_API_KEY=

# Port publié et interface d'écoute. Garder 127.0.0.1 sauf derrière un proxy
# TLS sur un réseau de confiance.
NEMO_SPEECH_PORT=9000
NEMO_SPEECH_BIND=127.0.0.1

# Variante GPU : architecture de la carte NVIDIA (120 : RTX 50xx, 89 : RTX 40xx,
# 86 : RTX 30xx). Vide : ensemble portable, construction plus longue.
CUDA_ARCH=

# Tâches de compilation en parallèle (vide : tous les cœurs).
BUILD_JOBS=
