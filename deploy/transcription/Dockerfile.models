# Télécharge les modèles GGUF du service de transcription dans le volume
# /models, une fois, en vérifiant leur SHA-256.
FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
RUN apk add --no-cache curl
COPY fetch-models.sh /usr/local/bin/fetch-models
# /models appartient à l'utilisateur 1000 : un volume neuf en hérite.
RUN adduser -D -u 1000 nemo \
    && chmod 0755 /usr/local/bin/fetch-models \
    && mkdir /models && chown 1000:1000 /models
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/fetch-models"]
