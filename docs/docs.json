{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Syntheo",
  "colors": {
    "primary": "#316745",
    "light": "#7DBF95",
    "dark": "#25553A"
  },
  "background": {
    "color": {
      "light": "#FBFAF5",
      "dark": "#1B1E1A"
    }
  },
  "fonts": {
    "heading": {
      "family": "Newsreader",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Prise en main",
            "pages": [
              "index",
              "desktop-installation",
              "uninstall",
              "ai-setup",
              "quickstart",
              "philosophy"
            ]
          },
          {
            "group": "Utiliser Syntheo",
            "pages": [
              "meetings",
              "dictation",
              "automatic-capture",
              "import-recordings",
              "notes",
              "folders",
              "customize-summaries",
              "chat",
              "contacts",
              "automations",
              "languages"
            ]
          },
          {
            "group": "Confidentialité et sécurité",
            "pages": [
              "data-and-privacy",
              "offline",
              "security",
              "conformite/rgpd"
            ]
          },
          {
            "group": "CLI et agents",
            "pages": [
              "installation",
              "agents/overview",
              "agents/cli",
              "agents/mcp",
              "agents/skills"
            ]
          },
          {
            "group": "Recettes",
            "pages": [
              "recipes/meeting-prep"
            ]
          },
          {
            "group": "Référence",
            "pages": [
              "reference/cli",
              "reference/mcp",
              "reference/webhooks",
              "reference/errors"
            ]
          },
          {
            "group": "Projet",
            "pages": [
              "architecture",
              "roadmap"
            ]
          },
          {
            "group": "Aide",
            "pages": [
              "help",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Carte du code",
        "groups": [
          {
            "group": "Knowledge graph",
            "pages": [
              "code/index",
              "code/doc-map"
            ]
          },
          {
            "group": "Applications",
            "pages": [
              "code/desktop",
              "code/cli"
            ]
          },
          {
            "group": "Modules",
            "pages": [
              "code/plugins",
              "code/crates-audio",
              "code/crates-data",
              "code/packages"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://github.com/WillIsback/Syntheo/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Télécharger",
      "href": "https://github.com/WillIsback/Syntheo/releases/latest"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/WillIsback/Syntheo"
    }
  },
  "description": "Le bloc-notes de réunion qui reste chez vous : transcription en temps réel et comptes rendus avec vos propres modèles.",
  "seo": {
    "metatags": {
      "og:site_name": "Syntheo",
      "og:locale": "fr_FR",
      "twitter:card": "summary_large_image",
      "keywords": "Syntheo, prise de notes de réunion, transcription de réunion, compte rendu de réunion, IA locale, open source, auto-hébergé, Whisper, Ollama, vLLM"
    },
    "indexing": "navigable"
  },
  "redirects": [
    {
      "source": "/calendar",
      "destination": "/notes"
    },
    {
      "source": "/docs",
      "destination": "/"
    },
    {
      "source": "/docs/:slug*",
      "destination": "/:slug*"
    }
  ]
}
